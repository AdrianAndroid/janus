    "ioredis": "^5.11.1",
    "lucide-react": "^0.460.0",
    "mysql2": "^3.22.6",
    "pg": "^8.22.0",
    "ssh2": "^1.16.0",
    "uuid": "^11.0.3",
    "ws": "^8.21.0",
    "zustand": "^5.0.1"
  },
